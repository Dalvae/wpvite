{
  "name": "wpvite",
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "dependencies": {
    "@hotwired/turbo": "^8.0.23",
    "alpinejs": "^3.15.5"
  },
  "devDependencies": {
    "@kucrut/vite-for-wp": "^0.12.0",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/vite": "^4.1.18",
    "daisyui": "^5.5.19",
    "impeccable": "^3.2.0",
    "lighthouse": "^13.4.0",
    "playwright": "^1.57.0",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.5",
    "vite-plugin-live-reload": "^3.1.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:critical": "vite build && node scripts/generate-critical-playwright.mjs",
    "critical:generate": "node scripts/generate-critical-playwright.mjs",
    "critical:verify": "node scripts/generate-critical-playwright.mjs --verify-only",
    "critical:legacy": "node scripts/generate-critical-css.mjs",
    "preview": "vite preview",
    "compose:site": "node scripts/compose-site.mjs",
    "compose:site:write": "node scripts/compose-site.mjs --write",
    "env:generate": "node scripts/generate-env.mjs",
    "impeccable:detect": "impeccable detect .",
    "impeccable:detect:json": "impeccable detect --json .",
    "impeccable:check": "impeccable check",
    "spin:init": "node scripts/spin-init.mjs",
    "site:apply": "node scripts/apply-site-config-wpcli.mjs",
    "site:apply:dry": "node scripts/apply-site-config-wpcli.mjs --dry-run",
    "wp:install:local": "bash scripts/wp-install-local.sh",
    "pipeline:validate": "node scripts/pipeline-validate.mjs",
    "perf:lhci": "lhci autorun",
    "perf:lhci:local": "LHCI_URL=${LHCI_URL:-http://localhost:8000} lhci autorun",
    "perf:lhci:collect": "lhci collect",
    "perf:lhci:assert": "lhci assert",
    "perf:lighthouse:local": "mkdir -p .lighthouseci && lighthouse ${PERF_URL:-http://localhost:8000} --chrome-flags=\"--headless --no-sandbox\" --form-factor=mobile --output=json --output-path=.lighthouseci/lighthouse-local-mobile.json --quiet",
    "perf:lighthouse:staging": "sh -c 'if [ -z \"$WP_STAGING_URL\" ]; then echo \"Set WP_STAGING_URL=https://...\" >&2; exit 1; fi; mkdir -p .lighthouseci; lighthouse \"$WP_STAGING_URL\" --chrome-flags=\"--headless --no-sandbox\" --form-factor=mobile --output=json --output-path=.lighthouseci/lighthouse-staging-mobile.json --quiet'",
    "setup": "node setup.js",
    "zip:theme": "bash scripts/build-zip.sh",
    "deploy:local": "bash scripts/deploy-theme-local.sh --activate",
    "wp": "docker compose --profile cli run --rm wpcli wp",
    "seed:local:pages": "WP_TARGET=local python3 scripts/seed-pages-rest.py",
    "seed:local:pages:dry": "WP_TARGET=local python3 scripts/seed-pages-rest.py --dry-run",
    "seed:local:content": "WP_TARGET=local python3 scripts/seed-content-rest.py",
    "seed:local:content:dry": "WP_TARGET=local python3 scripts/seed-content-rest.py --dry-run",
    "wpml:generate": "python3 scripts/generate-wpml-config.py",
    "wpml:check": "python3 scripts/generate-wpml-config.py --check",
    "wpml:dry-run": "python3 scripts/generate-wpml-config.py --dry-run",
    "wpml:send": "python3 scripts/wpml-send-to-translation.py",
    "wpml:send:dry": "python3 scripts/wpml-send-to-translation.py --dry-run",
    "wpml:send:headful": "python3 scripts/wpml-send-to-translation.py --headful",
    "wpml:export": "python3 scripts/wpml-export-xliff.py",
    "wpml:export:extract": "python3 scripts/wpml-export-xliff.py --extract",
    "wpml:export:headful": "python3 scripts/wpml-export-xliff.py --headful",
    "wpml:import": "python3 scripts/wpml-import-xliff.py",
    "wpml:import:headful": "python3 scripts/wpml-import-xliff.py --headful",
    "translate:init": "python3 scripts/translation-pipeline.py init",
    "translate:qa": "python3 scripts/translation-pipeline.py qa",
    "translate:qa:strict": "python3 scripts/translation-pipeline.py qa --strict",
    "translate:pack": "python3 scripts/translation-pipeline.py pack"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
