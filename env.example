# Network
IP=127.0.0.1
PORT=8000

# Database
DB_NAME=wordpress
DB_IP=127.0.0.1
DB_PORT=3306
# Required: set a unique strong value per site/environment. Do not use defaults on VPS/live.
DB_ROOT_PASSWORD=change-me-use-a-long-random-secret

# Theme
THEME_SLUG=starter

# WordPress
# Use 1 only for local development. Keep 0 on staging/live.
WORDPRESS_DEBUG=0

# ── Seeding (WordPress REST API) ──
# WP_BASE_URL=http://localhost:8000
# WP_USER=admin
# WP_APP_PASSWORD=

# ── WPML Playwright fallback scripts ──
# Prefer local WP-CLI where possible. Use these only for WPML/admin screens without stable CLI/REST support.
# WP_URL=https://example.com
# WP_ADMIN_URL=https://example.com/wp-admin
# WP_PASSWORD=
