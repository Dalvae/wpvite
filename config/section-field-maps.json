          "video_fallback_image": { "storage": "text", "wpml": "copy" },
          "image_id": { "storage": "text", "wpml": "copy" },
          "video_id": { "storage": "text", "wpml": "copy" },
          "mobile_image_id": { "storage": "text", "wpml": "copy" },
          "ticker_items": { "storage": "json", "wpml": "translate" },
          "proximity_panel": { "storage": "json", "wpml": "translate" }
        }
      },
      {
        "type": "stats-band",
        "prefix": "home_stats",
        "fields": {
