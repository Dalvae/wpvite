        "type": "faq-accordion",
        "prefix": "home_faq",
        "fields": {
          "kicker": { "storage": "text", "wpml": "translate" },
          "title": { "storage": "text", "wpml": "translate" },
          "items": { "storage": "json", "wpml": "translate" }
        }
      },
      {
        "type": "final-cta",
        "prefix": "home_final_cta",
        "fields": {
          "title": { "storage": "text", "wpml": "translate" },
